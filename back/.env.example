# Copie para a RAIZ como `.env` (ou `back/.env`) e preencha. Na Vercel,
# cadastre as mesmas chaves em Project Settings > Environment Variables.
# O banco de produção fica no Neon (Vercel Marketplace > Neon).
APP_NAME="mayckon.dev API"
ENV=dev

# --- Banco (Neon em produção; compose local abaixo) ---
# Local:  postgresql://postgres:postgres@localhost:5434/landingpage?sslmode=disable
# Neon:   postgresql://<user>:<senha>@<host>.neon.tech/<db>?sslmode=require
# Usuário/senha/nome do DB são os gerados no painel do Neon/Vercel.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/landingpage?sslmode=disable

# --- Auth (JWT + refresh 7 dias) ---
JWT_SECRET=troque-por-64-chars-aleatorios-gerados-com-openssl-rand-hex-32
JWT_ALG=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

# --- CORS (front) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:80

# --- Admin inicial do painel /admin (criado via POST /admins/seed) ---
SEED_ADMIN_NOME=Mayckon
SEED_ADMIN_EMAIL=mayckonkennedy877@gmail.com
SEED_ADMIN_SENHA=troque-esta-senha

# --- Cloudflare R2 (destino dos uploads; sem isso cai p/ disco local) ---
# Token: dashboard Cloudflare > R2 > Manage R2 API Tokens (permissão Object Read & Write).
# R2_PUBLIC_URL: Custom Domain ou Public r2.dev do bucket (ex: https://img.seudominio.com).
R2_ACCOUNT_ID=3592fbe8b47a0e7c8fc8d5a4402431cb
R2_BUCKET=landingpage
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
